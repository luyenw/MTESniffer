 
cmake_minimum_required(VERSION 2.8.2)

project(srsLTE-download NONE)

include(ExternalProject)
ExternalProject_Add(srsRAN
    GIT_REPOSITORY @SRSRAN_GIT_REPOSITORY@
    GIT_TAG @SRSRAN_GIT_TAG@
    # Pinned commit: no need to contact the remote again once checked out.
    UPDATE_DISCONNECTED 1
    SOURCE_DIR "${CMAKE_BINARY_DIR}/srsRAN-src"
    BINARY_DIR "${CMAKE_BINARY_DIR}/srsRAN-build"
    CONFIGURE_COMMAND ""
    BUILD_COMMAND ""
    INSTALL_COMMAND ""
    TEST_COMMAND ""
)
